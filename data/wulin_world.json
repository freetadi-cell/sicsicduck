    },
    {
      "day": 433,
      "text": "郭靖從耶律齊處獲悉，蒙古大汗已親徵，並調集了西域精銳回回炮隊，襄陽大戰將至。郭靖黃蓉連夜部署，下令全城進入戰備。",
      "npcs": [
        "guojing",
        "huangrong",
        "yelvqi"
      ]
    },
    {
      "day": 433,
      "text": "李莫愁被公孫止逼入絕境，憤然決定夜探古墓。她猜測小龍女所在，意圖奪取玉女心經殘卷或抓住小龍女作為籌碼。",
      "npcs": [
        "liguomochou"
      ]
    },
    {
      "day": 433,
      "text": "楊過與周伯通深入暗室，發現此地實為古墓派歷代傳人清修避世之所，藏有部分玉女心經的註解。楊過已書信邀小龍女前來一觀。",
      "npcs": [
        "yangguo",
        "zhoubotong"
      ]
    },
    {
      "day": 434,
      "text": "李莫愁趁夜潛入古墓，觸動‘斷龍石’機關，被困於墓道深處，進退不得。",
      "npcs": [
        "liguomochou"
      ]
    },
    {
      "day": 434,
      "text": "小龍女啟程前往終南山，行至半途，感應到古墓異動，心神不寧，加快腳步。",
      "npcs": [
        "xiaolongnu"
      ]
    },
    {
      "day": 434,
      "text": "郭靖在襄陽城外設下埋伏，擊退一支蒙古偵察隊；耶律齊密報，蒙古軍三日後將發動總攻。",
      "npcs": [
        "guojing",
        "yelvqi"
      ]
    },
    {
      "day": 435,
      "text": "小龍女趕至終南山，依楊過書信指引，徑往活死人墓。甫入墓門，便感內力凝滯，斷龍石機關已被觸發，一道沉重石閘封住退路。",
      "npcs": [
        "xiaolongnu"
      ]
    },
    {
      "day": 435,
      "text": "楊過久候小龍女不至，心下大不安。與周伯通在終南山暗室探查時，忽覺地下微震，傳來機括之聲，兩人急往古墓方嚮奔去。",
      "npcs": [
        "yangguo",
        "zhoubotong"
      ]
    },
    {
      "day": 435,
      "text": "李莫愁於古墓機關中屢試不出，心緒漸狂，忽聽遠處腳步聲響，竟是小龍女到來。她強壓驚喜，匿於暗處，伺機奪經。",
      "npcs": [
        "liguomochou"
      ]
    },
    {
      "day": 436,
      "text": "古墓深處，小龍女與李莫愁於玉女心經石壁前對峙，寒玉牀畔氣息凝滯。李莫愁催動赤練掌力，小龍女以玉女心經護體，兩人暗中較勁。",
      "npcs": [
        "xiaolongnu",
        "liguomochou"
      ]
    },
    {
      "day": 436,
      "text": "楊過與周伯通奔至古墓入口，見斷龍石封路。楊過以黯然銷魂掌力轟擊石門，周伯通以空明拳相助，巨石微震但未開。",
      "npcs": [
        "yangguo",
        "zhoubotong"
      ]
    },
    {
      "day": 436,
      "text": "襄陽城中，耶律齊冒死送來密報：蒙古大軍已移營至城東五里，回回炮陣列成形，總攻將於明日卯時發動。郭靖下令全軍披甲。",
      "npcs": [
        "yelvqi",
        "guojing",
        "huangrong"
      ]
    },
    {
      "day": 437,
      "text": "襄陽城外蒙古回回炮於卯時齊發，郭靖與黃蓉以火油、石灰和夜間加固的城垣迎戰，城東炮火雖猛，首輪攻勢終被守軍逼退。",
      "npcs": [
        "guojing",
        "huangrong",
        "yelvqi"
      ]
    },
    {
      "day": 437,
      "text": "耶律齊冒險混入蒙古炮陣，放火燒毀兩座炮車後負傷逃回襄陽；郭靖親自接應，蒙古軍因陣腳大亂暫退五里。",
      "npcs": [
        "yelvqi",
        "guojing"
      ]
    },
    {
      "day": 437,
      "text": "古墓之中，李莫愁趁小龍女運功之際突施冰魄銀針，反被小龍女以玉女劍法逼退。墓外楊過與周伯通合力尋得機括，斷龍石終於升起一道縫隙。",
      "npcs": [
        "xiaolongnu",
        "liguomochou",
        "yangguo",
        "zhoubotong"
      ]
    },
    {
      "day": 438,
      "text": "蒙古軍重整旗鼓，以回回炮猛轟襄陽城東南角，城牆崩塌數處，郭靖率親兵死守缺口，黃蓉急令百姓轉移。",
      "npcs": [
        "guojing",
        "huangrong"
      ]
    },
    {
      "day": 438,
      "text": "楊過與周伯通趁斷龍石升起縫隙，以內力灌注機括，石門緩緩抬升。楊過大喜，正欲入內，卻聽見小龍女與李莫愁的交手聲。",
      "npcs": [
        "yangguo",
        "zhoubotong"
      ]
    },
    {
      "day": 438,
      "text": "李莫愁見斷龍石升起，心知楊過即將闖入，孤注一擲撲嚮寒玉牀上的玉女心經殘卷，小龍女挺劍攔截，兩人於狹窄墓道中再戰。",
      "npcs": [
        "xiaolongnu",
        "liguomochou"
      ]
    },
    {
      "day": 439,
      "text": "蒙古軍以回回炮集中轟擊襄陽城北，城牆崩出大缺口。郭靖率親兵死守缺口，黃蓉指揮百姓從地道撤離；耶律齊送來蒙古軍換防密報，使守軍在缺口處設下埋伏，暫挫敵鋒。",
      "npcs": [
        "guojing",
        "huangrong",
        "yelvqi"
      ]
    },
    {
      "day": 439,
      "text": "古墓內，楊過衝入墓中，與小龍女聯手施展玉女心經劍法，逼退李莫愁。李莫愁重傷遁逃，誓言復仇；楊過與小龍女重逢，情意更濃。",
      "npcs": [
        "yangguo",
        "xiaolongnu",
        "liguomochou"
      ]
    },
    {
      "day": 439,
      "text": "公孫止趁古墓內鬥，潛入終南山意圖奪取玉女心經殘卷，卻與趕來的周伯通相遇；兩人在暗室中交手，公孫止以情花毒暗算，周伯通以左右互搏戲耍應對。",
      "npcs": [
        "gongsunzhi",
        "zhoubotong"
      ]
    },
    {
      "day": 440,
      "text": "蒙古軍調整戰術，轉而猛攻襄陽城西，郭靖率軍馳援，黃蓉設計以火油焚毀攻城器械，暫挫敵鋒，但城西缺口擴大。",
      "npcs": [
        "guojing",
        "huangrong"
      ]
    },
    {
      "day": 440,
      "text": "楊過與小龍女在古墓暗室中發現玉女心經完整古卷，商議後決定與周伯通分享，三人研究心法，暗室中劍氣繚繞，似有突破之象。",
      "npcs": [
        "yangguo",
        "xiaolongnu",
        "zhoubotong"
      ]
    },
    {
      "day": 440,
      "text": "李莫愁潛回絕情谷療傷，公孫止趁她虛弱，以情花毒脅迫她合作，李莫愁憤然反抗，兩人關係徹底破裂，絕情谷內毒霧瀰漫。",
      "npcs": [
        "liguomochou",
        "gongsunzhi"
      ]
    },
    {
      "day": 441,
      "text": "蒙古軍利用城西缺口猛攻，郭靖親率敢死隊堵口，黃蓉設計以火油焚毀攻城器械，暫穩局麵，但傷亡慘重。",
      "npcs": [
        "guojing",
        "huangrong"
      ]
    },
    {
      "day": 441,
      "text": "楊過與小龍女在暗室中突破玉女心經瓶頸，內力交融，周伯通旁觀領悟，古墓派武功精進，三人決定出關助戰。",
      "npcs": [
        "yangguo",
        "xiaolongnu",
        "zhoubotong"
      ]
    },
    {
      "day": 441,
      "text": "李莫愁在絕情谷毒霧中療傷，公孫止突施冷箭偷襲，李莫愁重傷逃出，誓言先殺小龍女再報公孫止之仇。",
      "npcs": [
        "liguomochou",
        "gongsunzhi"
      ]
    },
    {
      "day": 442,
      "text": "蒙古軍增兵猛攻城西缺口，郭靖率親兵死守，黃蓉設計以滾木擂石阻敵，戰況慘烈，城垣震動。",
      "npcs": [
        "guojing",
        "huangrong"
      ]
    },
    {
      "day": 442,
      "text": "楊過、小龍女與周伯通心法大成，自終南山暗室出關，施展輕功直奔襄陽，誓助郭伯伯守城。",
      "npcs": [
        "yangguo",
        "xiaolongnu",
        "zhoubotong"
      ]
    },
    {
      "day": 442,
      "text": "李莫愁在絕情谷外山洞療傷，公孫止派弟子追殺，李莫愁以冰魄銀針反殺三人，怨毒更甚，誓言報復。",
      "npcs": [
        "liguomochou",
        "gongsunzhi"
      ]
    },
    {
      "day": 443,
      "text": "楊過、小龍女與周伯通抵達襄陽城西缺口，三人以心法大成後的武功合力守城，楊過以黯然銷魂掌擊退蒙古先鋒，小龍女以玉女劍法守護城牆，周伯通以左右互搏戲耍敵軍，暫緩戰局。",
      "npcs": [
        "yangguo",
        "xiaolongnu",
        "zhoubotong",
        "guojing",
        "huangrong"
      ]
    },
    {
      "day": 443,
      "text": "李莫愁趁公孫止不備，潛入絕情谷放火燒毀毒草園，公孫止大怒，率弟子追殺，兩人於情花叢中惡鬥，李莫愁以冰魄銀針重傷公孫止，但自身亦中毒。",
      "npcs": [
        "liguomochou",
        "gongsunzhi"
      ]
    },
    {
      "day": 443,
      "text": "蒙古軍見襄陽援軍到來，調整戰術，分兵多路佯攻，意圖分散守軍兵力。耶律齊密報此情，郭靖緊急部署。",
      "npcs": [
        "yelvqi",
        "guojing",
        "huangrong"
      ]
    }
  ]
}