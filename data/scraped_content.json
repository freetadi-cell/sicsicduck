      "html": "<!doctype html>\r\n<html class=\"no-js\" xml:lang=\"zh-hk\" lang=\"zh-hk\">\r\n  <head>\r\n    <meta charset=\"utf-8\" />\r\n    <meta http-equiv=\"x-ua-compatible\" content=\"ie=edge\" />\r\n    <meta name=\"viewport\" content=\"width=device-width\" />\r\n    <title>新資金定期存款優惠 | 恒生銀行</title>\r\n    <meta\r\n      name=\"keywords\"\r\n      content=\"恒生, 恒生銀行, 銀行, 定存, 優惠, 定存利率優惠, 定存金額, 定期存款, 定期存款戶口, 定期存款利率優惠, 新資金優惠, 特優年利率, 定期存款特優年利率, 優越私⼈理財, 優越理財, 優進理財, 綜合戶口, 個人e-banking, 銀行服務, 存款戶口, 銀行戶口, 定期帳戶, 存款期, 年利率, 合資格新資金結餘, 網上銀行, 恒生Mobile App, 恒生電話理財熱線, 分行, 存款期, 加元, 人民幣, 英鎊, 澳元, 紐西蘭元, 美元, 港元, 一星期定存, 三個月定存, 恒生銀行分行, 推廣, 交易時段, 儲蓄, 儲蓄賬戶, 往來賬戶, 定期賬戶, 外幣, 續存, 續存定期存款, 匯率\"\r\n    />\r\n    <meta\r\n      name=\"summary\"\r\n      content=\"透過網上理財 (包括恒生個人e-Banking及恒生Mobile App)、電話理財或分行，以指定金額的「合資格新資金結餘」設立定期存款，可根據定期存款戶口類別專享特優年利率。\"\r\n    />\r\n    <meta\r\n      name=\"description\"\r\n      content=\"透過網上理財 (包括恒生個人e-Banking及恒生Mobile App)、電話理財或分行，以指定金額的「合資格新資金結餘」設立定期存款，可根據定期存款戶口類別專享特優年利率。\"\r\n    />\r\n    <meta\r\n      http-equiv=\"Cache-Control\"\r\n      content=\"no-cache, no-store, must-revalidate\"\r\n    />\r\n    <meta http-equiv=\"Pragma\" content=\"no-cache\" />\r\n    <meta http-equiv=\"Expires\" content=\"0\" />\r\n    <link rel=\"stylesheet\" href=\"images/videohub.min.css\" />\r\n    <link rel=\"stylesheet\" href=\"/cms/emkt/pmo/common/css/promo_main.css\" />\r\n    <link rel=\"stylesheet\" href=\"./images/style.css\" />\r\n    <script\r\n      language=\"JavaScript\"\r\n      src=\"/cms/emkt/pmo/common/js/common.js\"\r\n    ></script>\r\n    <script\r\n      language=\"JavaScript\"\r\n      src=\"/cms/emkt/pmo/common/mobile-app-agent.html\"\r\n    ></script>\r\n    <link href=\"images/newfund.css\" rel=\"stylesheet\" type=\"text/css\" />\r\n    <link rel=\"stylesheet\" href=\"images/slider.css\" />\r\n    <link rel=\"stylesheet\" href=\"images/app.css\" />\r\n    <link href=\"images/popup.css\" rel=\"stylesheet\" type=\"text/css\" />\r\n    <link rel=\"stylesheet\" href=\"images/tab.css\" />\r\n    <link rel=\"stylesheet\" href=\"images/header_banner.css\" />\r\n\r\n    <!--[if lt IE 9]>\r\n      <script src=\"/cms/emkt/pmo/common/js/vendor/jquery.min_old.js\"></script>\r\n      <script src=\"/cms/emkt/pmo/common/js/rem.min.js\"></script>\r\n    <![endif]-->\r\n    <!--[if gt IE 8]><!-->\r\n\r\n    <script\r\n      language=\"Javascript\"\r\n      src=\"/cms/emkt/pmo/common/js/vendor/ua-parser.min.js\"\r\n    ></script>\r\n    <script\r\n      language=\"Javascript\"\r\n      src=\"/cms/emkt/pmo/common/js/vendor/jquery.min.js\"\r\n    ></script>\r\n    <script\r\n      language=\"Javascript\"\r\n      src=\"https://cms.hangseng.com/cms/emkt/pmo/grp05/p52/chi/js/url_view_chi.js\"\r\n    ></script>\r\n    <script\r\n      language=\"Javascript\"\r\n      src=\"/cms/emkt/pmo/common/js/logobar_pmo.js\"\r\n    ></script>\r\n    <script\r\n      language=\"JavaScript\"\r\n      src=\"/cms/emkt/pmo/common/js/com/wt/common.js\"\r\n    ></script>\r\n    <script\r\n      language=\"JavaScript\"\r\n      src=\"/cms/emkt/pmo/common/js/com/wt/bottom_section.js\"\r\n    ></script>\r\n    <script\r\n      language=\"JavaScript\"\r\n      src=\"/cms/emkt/pmo/common/js/chi/wt/oth.js\"\r\n    ></script>\r\n    <script\r\n      language=\"Javascript\"\r\n      src=\"/cms/emkt/pmo/common/js/chi/com/all_logon.js\"\r\n    ></script>\r\n    <script\r\n      language=\"Javascript\"\r\n      src=\"/cms/emkt/pmo/common/js/vendor/listbox.js\"\r\n    ></script>\r\n    <!-- openWebView-->\r\n    <style>\r\n      #main_content_area .row {\r\n        padding: 20px 8px 20px;\r\n      }\r\n      #main_content_area .xml-table {\r\n        padding-bottom: 0;\r\n      }\r\n      #main_content_area .btn2 {\r\n        margin: 0 auto;\r\n      }\r\n      p {\r\n        text-justify: distribute !important;\r\n      }\r\n      .word2.mt-0 {\r\n        margin-bottom: 0 !important;\r\n      }\r\n      .h3 {\r\n        margin-bottom: 0;\r\n      }\r\n      