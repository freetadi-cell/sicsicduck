      "html": "<!DOCTYPE HTML>\n<html lang=\"zh-HK\">\n\n<head><script src=\"/mult-by-a-Fatalongle-him-Exeunt-Why-That-omneys-\" async></script>\n    <meta charset=\"UTF-8\"/>\n    <title>渣打銀行網上定期存款｜新資金尊享特惠定期存款利率 – 渣打銀行香港</title>\n    \n    <meta name=\"description\" content=\"渣打銀行網上定期存款，多達10種貨幣選擇，新資金更可享定期存款特惠利率！簡單3步開立定期戶口，以新資金賺特高定期利息！\"/>\n    <meta name=\"template\" content=\"product-details\"/>\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/>\n    \n\n    \n    <meta name=\"sc:country\"/>\n\n    \n        <meta property=\"og:title\" content=\"渣打銀行網上定期存款｜新資金尊享特惠定期存款利率 – 渣打銀行香港\"/>\n        <meta property=\"og:description\" content=\"渣打銀行網上定期存款，多達10種貨幣選擇，新資金更可享定期存款特惠利率！簡單3步開立定期戶口，以新資金賺特高定期利息！\"/>\n        <meta property=\"og:image\" content=\"https://www.sc.com/content/dam/sc/hk/en/deposits/hk-online-td-pintile-600x600-1.jpg\"/>\n        <meta property=\"og:url\" content=\"https://www.sc.com/hk/zh/deposits/online-time-deposit/\"/>\n        <meta property=\"og:type\" content=\"website\"/>\n        <meta property=\"og:locale\" content=\"zh_HK\"/>\n        <meta property=\"og:site_name\" content=\"Standard Chartered\"/>\n        <meta name=\"twitter:card\" content=\"summary_large_image\"/>\n        <meta name=\"twitter:title\" content=\"渣打銀行網上定期存款｜新資金尊享特惠定期存款利率 – 渣打銀行香港\"/>\n        <meta name=\"twitter:description\" content=\"渣打銀行網上定期存款，多達10種貨幣選擇，新資金更可享定期存款特惠利率！簡單3步開立定期戶口，以新資金賺特高定期利息！\"/>\n        <meta name=\"twitter:image\" content=\"https://www.sc.com/content/dam/sc/hk/en/deposits/hk-online-td-pintile-600x600-1.jpg\"/>\n        <meta name=\"twitter:site\"/>\n    \n    <meta name='robots' content='max-image-preview:large'/>\n    <meta name=\"content-page-ref\" content=\"nqDXxPKZ9-yVn4v-4jKKhBpwkcoSsxS5ZSgXawZOsKrDxoC8KO1xES5qr9lGaQ59GUHJmkJj4Mw_U3ZOuvYa4bl-QywBCzfJHDm6HUFrXbk\"/>\n<script defer=\"defer\" type=\"text/javascript\" src=\"/.rum/@adobe/helix-rum-js@%5E2/dist/micro.js\"></script>\n<link href='//www.google-analytics.com' rel=