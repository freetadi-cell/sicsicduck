由兌換。倘若你選擇將外幣及人民幣存款兌換為其他貨幣時的匯率較當初兌換外幣及人民幣時的匯率為差，則可能會因而蒙受本金損失。客戶應事先考慮及了解因此在人民幣資金方面可能受到的影響。</span></div>\r\n          <div class=\"cta-container hide-mobile\">\r\n            <div class=\"button-container\"> <a href=\"/zh_HK/download-app.html\" target=\"_blank\" class=\"button-primary typography-button text-decoration-none\" style=\"padding: 0 20px;\">下載 App</a> </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n        <!-- End of Desktop text and cta button-->\r\n\r\n      <div class=\"col-12 order-2 col-md-6 order-md-2\">\r\n        <div class=\"image-content d-flex justify-content-center\"> <img src=\"https://www.livibank.com/dam/livi1/features/liviSave/TimeDeposit/Space_2Accounts_tc-1x.webp\" alt=\"This is Title\"> </div>\r\n      </div>\r\n\r\n         <!-- Mobile cta button (hide in desktop)-->\r\n      <div class=\"col-12 order-3 col-md-6 order-md-1 hide-desktop\">\r\n        <div class=\"text-content\">\r\n          <div class=\"cta-container\">\r\n            <div class=\"button-container\"> <a href=\"/zh_HK/download-app.html\" class=\"button-primary typography-button text-decoration-none\" style=\"padding: 0 20px;\">下載 App</a> </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n         <!-- End of Mobile cta button (hide in desktop)-->\r\n    </div>\r\n  </div>\r\n</section>\r\n\n\n<link rel=\"stylesheet\" id=\"style_tdrate\" type=\"text/css\" href=\"/.resources/livibank-templates/webresources/css/tdRate.css\">\n<script>\n$(function () {\n  let start = 1,\n    end = 2;\n  let max = $($(\".time-deposit-rate-table-container-mobile tr\")[0]).children().length;\n  function updateColumns() {\n     $(\".time-deposit-rate-table-container-mobile tr\").each(function (index, row) {\n      $(row).children().each(function (index, item) {\n          if(index == 0){\n            $(item).css(\"display\", \"table-cell\");\n            $(item).css(\"width\", \"150px\");\n            $(item).css(\"max-width\", \"30%\");\n          }\n          else i