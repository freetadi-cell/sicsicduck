# ============================================================
# Live scraping functions
# ============================================================

def scrape_virtual_banks():
    """Try to scrape virtual bank pages with agent-browser."""
    results = {}
    for bank_name, url in VIRTUAL_BANK_URLS.items():
        logger.info(f"Trying agent-browser for {bank_name}: {url}")
        rates = scrape_with_agent_browser(url)
        if rates:
            results[bank_name] = rates
            logger.info(f"  Got rates for {bank_name}: {rates}")
        else:
            logger.warning(f"  Failed to get rates for {bank_name} via agent-browser")
        time.sleep(1)
    return results


def scrape_aggregator_sites():
    """Fetch rates from StashAway and Syfe aggregator pages."""
    results = {}
    
    # Try StashAway HKD
    logger.info("Fetching StashAway HKD page...")
    html = fetch_url(STASHAWAY_HKD_URL)
    if html:
        logger.info(f"  StashAway HKD: fetched {len(html)} chars")
    
    # Try StashAway USD
    logger.info("Fetching StashAway USD page...")
    html = fetch_url(STASHAWAY_USD_URL)
    if html:
        logger.info(f"  StashAway USD: fetched {len(html)} chars")
    
    # Try Syfe USD
    logger.info("Fetching Syfe USD page...")
    html = fetch_url(SYFE_USD_URL)
    if html:
        logger.info(f"  Syfe USD: fetched {len(html)} chars")
    
    # Note: Full parsing of these pages is complex due to dynamic rendering.
    # The baseline data from get_latest_rates_data() is used as the reliable source.
    # Live scraping enhancement can be added incrementally.
    
    return results


def try_moneyhero():
    """Try MoneyHero as a fallback source."""
    logger.info("Trying MoneyHero...")
    html = fetch_url(MONEYHERO_URL)
    if html:
        logger.info(f"  MoneyHero: fetched {len(html)} chars")
        # MoneyHero uses JS rendering, web_fetch may not get full data
    return {}


# ============================================================
# Main update logic
# ============================================================

def update_rates():
    """Main function to update rates.json."""
    logger.info("=" * 50)
    logger.info("HK Deposit Rates Update")
    logger.info(f"Time: {datetime.now(HKT).strftime('%Y-%m-%d %H:%M:%S')}")
    logger.info("=" * 50)
    
    # Load existing data
    os.makedirs(DATA_DIR, exist_ok=True)
    if not os.path.exists(RATES_FILE):
        logger.error("rates.json not found!")
        return False
    
    with open(RATES_FILE, 'r', encoding='utf-8') as f:
        data = json.load(f)
    
    # Get baseline rates data
    new_rates = get_latest_rates_data()
    
    # Try live scraping to enhance data
    try:
        scrape_aggregator_sites()
    except Exception as e:
        logger.warning(f"Aggregator scraping failed: {e}")
    
    # Try agent-browser for virtual banks (if available)
    try:
        vb_rates = scrape_virtual_banks()
        for bank_name, rates in vb_rates.items():
            if bank_name in new_rates:
                for period, rate in rates.items():
                    if period in new_rates[bank_name].get('hkd', {}):
                        current = new_rates[bank_name]['hkd'][period]
                        if isinstance(current, dict):
                            if rate > (current.get('rate') or 0):
                                current['rate'] = rate
                                current['source'] = 'bank'
    except Exception as e:
        logger.warning(f"Virtual bank scraping failed: {e}")
    
    # Always close browser session
    try:
        agent_browser_cmd('close', timeout_ms=5000)
    except:
        pass
    
    # Try MoneyHero fallback
    try:
        moneyhero_data = try_moneyhero()
    except Exception as e:
        logger.warning(f"MoneyHero fetch failed: {e}")
    
    # Update the JSON data
    banks_updated = 0
    for bank in data.get('banks', []):
        bank_name = bank['name']
        if bank_name in new_rates:
            bank_rates = new_rates[bank_name]
            source = bank_rates.get('_source', 'stashaway')
            
            for currency in ['hkd', 'usd']:
                if currency not in bank_rates:
                    continue
                for period in ['1m', '3m', '6m', '12m']:
                    if period in bank_rates[currency]:
                        rate_info = bank_rates[currency][period]
                        if isinstance(rate_info, dict) and 'rate' in rate_info:
                            old_rate = bank[currency][period].get('rate') if bank[currency][period] else None
                            new_rate = rate_info['rate']
                            
                            # Update rate
                            bank[currency][period] = {
                                'rate': new_rate,
                                'min_deposit': rate_info.get('min_deposit'),
                                'note': rate_info.get('note', ''),
                                'source': source,
                            }
                            
                            # If source is moneyhero, append * to note
                            if source == 'moneyhero':
                                note = bank[currency][period]['note']
                                if note and not note.endswith('*'):
                                    bank[currency][period]['note'] = note + ' *'
                                elif not note:
                                    bank[currency][period]['note'] = '*'
            banks_updated += 1
    
    # Update timestamp and source
    data['last_updated'] = datetime.now(HKT).strftime('%Y-%m-%dT%H:%M:%S+08:00')
    data['source'] = 'StashAway / 各銀行官網 / MoneyHero'
    
    # Save
    with open(RATES_FILE, 'w', encoding='utf-8') as f:
        json.dump(data, f, ensure_ascii=False, indent=2)
    
    logger.info(f"Updated {banks_updated} banks in rates.json")
    logger.info(f"Timestamp: {data['last_updated']}")
    return True


def main():
    success = update_rates()
    if success:
        logger.info("✅ Update completed successfully")
        return 0
    else:
        logger.error("❌ Update failed")
        return 1


if __name__ == '__main__':
    sys.exit(main())
